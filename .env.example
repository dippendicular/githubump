# Choose one backend. Existing Upstash deployments can omit COUNTER_STORAGE.
COUNTER_STORAGE=upstash
KV_REST_API_URL=https://your-project.upstash.io
KV_REST_API_TOKEN=your_read_write_token

# SQLite (single host with persistent storage and Node.js 22.13+)
# COUNTER_STORAGE=sqlite
# COUNTER_SQLITE_PATH=./data/counters.sqlite

# Self-hosted standalone Redis
# COUNTER_STORAGE=redis
# REDIS_URL=redis://127.0.0.1:6379

# Optional
# GITHUB_API_TOKEN=your_github_pat
# ADMIN_API_TOKEN=your_random_admin_secret
